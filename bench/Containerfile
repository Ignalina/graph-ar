FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake curl wget git ca-certificates lsb-release pkg-config ninja-build time python3 \
 && wget -q https://apache.jfrog.io/artifactory/arrow/ubuntu/apache-arrow-apt-source-latest-noble.deb \
 && apt-get install -y ./apache-arrow-apt-source-latest-noble.deb && apt-get update \
 && apt-get install -y libarrow-dev=24.0.0-1 libarrow-dataset-dev=24.0.0-1 libarrow-acero-dev=24.0.0-1 libparquet-dev=24.0.0-1 libarrow-compute-dev=24.0.0-1 libboost-graph-dev \
 && rm -rf /var/lib/apt/lists/*
RUN curl --proto =https --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.91.1
ENV PATH=/root/.cargo/bin:$PATH
WORKDIR /w
